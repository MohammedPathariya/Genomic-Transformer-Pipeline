# --- Research Data & Bioinformatics ---
# Raw sequencing files — never commit these (large, binary)
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.bai
*.fast5
*.pod5

# FASTA files are ignored globally EXCEPT the HXB2 reference
# (handled by negation rule below)
*.fasta
*.fa

# Keep HXB2 reference and HIVDB XML in the repo
!data/public/HXB2_reference.fasta
!data/public/HIVDB_9.8.xml
!data/public/HXB2_reference.mmi

# Ignore derived/large data directories
data/actg_fastq/
data/processed/
data/test/

# Keep Stanford HIVdb resistant subsets and source metadata
!data/raw/stanford_hivdb/PR_resistant.txt
!data/raw/stanford_hivdb/RT_resistant.txt
!data/raw/stanford_hivdb/IN_resistant.txt
!data/raw/stanford_hivdb/SOURCE.md

# --- Python & Environments ---
__pycache__/
*.py[cod]
*.class
*.so
.Python
env/
venv/
.env
.venv
pip-log.txt
pip-delete-this-directory.txt
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*-checkpoint.ipynb

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Logs ---
*.log
logs/
dataset_generation.log

# --- Reference Documents ---
docs/*.pdf

# --- Reference Repos ---
reference_repos/.vscode/
.vscode/results/

# Explicitly tracked — expanded Stanford HIVdb dataset
!data/raw/stanford_hivdb_5k/PR_resistant.txt
!data/raw/stanford_hivdb_5k/RT_resistant.txt
!data/raw/stanford_hivdb_5k/IN_resistant.txt
!data/raw/stanford_hivdb_5k/SOURCE.md
